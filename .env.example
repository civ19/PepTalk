# Hostname or LAN IP used to open the Docker development server.
DEV_HOST=localhost

# Docker database settings. Presage vitals, Gemini coaching, and signed-in account
# projects/preparations are saved to this database. Videos and reference files stay in the browser.
POSTGRES_PASSWORD=change-this-for-a-shared-server
POSTGRES_PORT=5433

# Tiger Data connection string for local runs (Tiger Console > your service > Connect),
# e.g. postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# When set, the backend saves Presage vitals and Gemini coaching to Tiger Data. Run `npm run db:migrate` once per database.
DATABASE_URL=

# Keep API keys on the server. Leave unused integrations empty.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMARTSPECTRA_API_KEY=

# Auth0: create a Single Page Application and an API with the identifier below.
# Set the SPA's Allowed Callback URLs and Allowed Logout URLs to the site origin,
# and enable the Google social connection in Auth0 for "Continue with Google".
# AUTH0_DOMAIN is the tenant hostname only (for example, tenant.us.auth0.com).
# AUTH0_AUDIENCE must exactly match the Identifier of an Auth0 API created under
# Dashboard > Applications > APIs. An arbitrary URL causes "Service not found".
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
