# Hostname or LAN IP used to open the Docker development server.
DEV_HOST=localhost

# Docker database settings (the database is provisioned but sessions are still browser-local).
POSTGRES_PASSWORD=change-this-for-a-shared-server
POSTGRES_PORT=5433

# Keep API keys on the server. Leave unused integrations empty.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMARTSPECTRA_API_KEY=
