# SmartSpectra API key from https://physiology.presagetech.com/
PRESAGE_API_KEY=

# TigerData (Postgres + TimescaleDB) connection string, from the TigerData
# console's connection info. TLS is required and always verified; an sslmode
# weaker than "require" is rejected. Leave empty to keep sessions local only.
# The console's copyable string omits the password: insert it after the user
# (tsdbadmin:<password>@...), URL-encoding any special characters, or set PGPASSWORD.
# Create the tables once with: npm run db:migrate
DATABASE_URL=
# Example: postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
